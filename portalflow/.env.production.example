NODE_ENV=production
DATABASE_URL=postgresql://portalflow:REPLACE_WITH_SECRET@db.internal:5432/portalflow?sslmode=require
REDIS_URL=rediss://default:REPLACE_WITH_SECRET@redis.internal:6379
WEB_ORIGIN=https://portalflow.example.com
API_URL=http://api:4000
PORT=4000
COOKIE_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SECRET
SMTP_PASSWORD=REPLACE_WITH_SECRET
SMTP_FROM=PortalFlow <hello@example.com>

# Public WebSocket origin; set at web image build time, no credentials.
NEXT_PUBLIC_API_ORIGIN=https://portalflow.example.com
