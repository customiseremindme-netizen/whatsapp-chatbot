{
  "name": "portalflow",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --env-file=.env scripts/env.mjs vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "node --env-file=.env scripts/env.mjs pnpm --filter @portalflow/database generate",
    "db:migrate": "node --env-file=.env scripts/env.mjs pnpm --filter @portalflow/database migrate",
    "db:seed": "node --env-file=.env scripts/env.mjs pnpm --filter @portalflow/database seed",
    "dev": "pnpm build && concurrently -k \"pnpm --filter @portalflow/api start\" \"pnpm --filter @portalflow/web dev\"",
    "format": "prettier --write .",
    "test:worker": "node --env-file=.env scripts/test-worker.mjs",
    "admin:grant": "node --env-file=.env scripts/env.mjs tsx scripts/grant-admin.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "turbo": "2.11.10",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.48.0",
    "@eslint/js": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vitest": "^4.0.15",
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.2.1",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0"
  }
}
